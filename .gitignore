# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj
# Wavefront OBJ models are source assets (ADR 0012), not compiled objects.
!assets/**/*.obj
!tests/**/fixtures/**/*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll
*.so.*

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Build directories
build/
Build/
build-*/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Local Python environment (Conan and tooling)
.venv/

# Personal CMake presets
CMakeUserPresets.json

# Git worktrees created by Claude Code. The project works in one checkout
# (docs/DEVELOPMENT_WORKFLOW.md); the shared skills in .claude/skills/ stay tracked.
.claude/worktrees/

# Screenshots taken with F12 at runtime. Curated screenshots live in docs/screenshots/.
/screenshots/

# World settings saved from island-preview's WorldGen panel at runtime (its
# default file is worlds/world.json). Shipped worlds live in assets/worlds/.
/worlds/
