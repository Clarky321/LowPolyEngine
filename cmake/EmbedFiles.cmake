# Embeds files into a generated C++ source, so a program needs no files of its
# own at run time and reads nothing from the source tree: Raven's shader
# sources for the engine's Raven backend, the editor's XML layouts (M5.2,
# ADR 0027). The generated file lives in the build folder and is rewritten
# only when its content changes; CMake configures again when an embedded file
# changes.
#
#   lpe_embed_files(<output.cpp> <namespace> <name> <file> [<name> <file>...])
#
# defines, for each pair, `std::string_view <namespace>::<name>() noexcept`
# returning the file's bytes (without a terminating zero). A header written by
# hand declares the functions.

function(lpe_embed_files output namespace)
    set(pairs ${ARGN})
    list(LENGTH pairs count)
    math(EXPR remainder "${count} % 2")
    if(count EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "lpe_embed_files(${output}): expected <name> <file> pairs")
    endif()

    set(sources "")
    set(constants "")
    set(functions "")
    while(pairs)
        list(POP_FRONT pairs name file)
        if(NOT EXISTS "${file}")
            message(FATAL_ERROR "lpe_embed_files: '${file}' does not exist")
        endif()
        file(SIZE "${file}" size)
        if(size EQUAL 0)
            message(FATAL_ERROR "lpe_embed_files: '${file}' is empty")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
        file(READ "${file}" hex HEX)
        # Two hex digits per byte, 16 bytes per line.
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
        file(RELATIVE_PATH shown "${PROJECT_SOURCE_DIR}" "${file}")
        string(APPEND sources "//   ${shown}\n")
        string(APPEND constants "// ${shown} (${size} bytes)\nconstexpr unsigned char k_${name}[] = {\n    ${bytes}\n};\n\n")
        string(APPEND functions "std::string_view ${name}() noexcept\n{\n    return {reinterpret_cast<const char*>(k_${name}), sizeof(k_${name})};\n}\n\n")
    endwhile()

    set(content "// Generated by cmake/EmbedFiles.cmake; do not edit. Embedded files:\n${sources}\n#include <string_view>\n\nnamespace ${namespace} {\n\nnamespace {\n\n${constants}} // namespace\n\n${functions}} // namespace ${namespace}\n")
    set(previous "")
    if(EXISTS "${output}")
        file(READ "${output}" previous)
    endif()
    if(NOT previous STREQUAL content)
        file(WRITE "${output}" "${content}")
    endif()
endfunction()
